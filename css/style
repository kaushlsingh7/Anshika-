/* =========================================================
   ROMANTIC EXPERIENCE - LUXURY DESIGN SYSTEM & STYLESHEET
   100% PHONE & DESKTOP RESPONSIVE
   ========================================================= */

:root {
  --bg-primary: #09040e;
  --bg-secondary: #13071b;
  --bg-card: rgba(26, 12, 36, 0.7);
  --bg-card-hover: rgba(45, 18, 64, 0.82);
  
  --rose-primary: #ff3366;
  --rose-glow: rgba(255, 51, 102, 0.4);
  --rose-deep: #b3103f;
  --crimson: #e60050;
  
  --gold-primary: #f6d365;
  --gold-warm: #fda085;
  --gold-glow: rgba(246, 211, 101, 0.4);
  
  --champagne: #fff2e2;
  --text-primary: #ffffff;
  --text-muted: rgba(255, 235, 245, 0.8);
  --text-dim: rgba(255, 220, 235, 0.55);
  
  --glass-border: rgba(255, 180, 210, 0.2);
  --glass-border-hover: rgba(255, 120, 170, 0.5);
  --glass-shadow: 0 15px 35px rgba(0, 0, 0, 0.55), 0 0 25px rgba(255, 51, 102, 0.15);
  
  --font-display: 'Playfair Display', Georgia, serif;
  --font-handwriting: 'Great Vibes', cursive;
  --font-body: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
  
  --transition-smooth: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  --transition-bounce: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
  background-color: var(--bg-primary);
  color: var(--text-primary);
  overflow-x: hidden;
  width: 100%;
}

body {
  font-family: var(--font-body);
  background: radial-gradient(circle at 50% 0%, #200a2c 0%, #0d0414 50%, #060209 100%);
  min-height: 100vh;
  overflow-x: hidden;
  width: 100%;
  position: relative;
  line-height: 1.6;
  color: var(--text-primary);
  padding-bottom: env(safe-area-inset-bottom);
}

/* Custom Romantic Scrollbar */
::-webkit-scrollbar {
  width: 6px;
}
::-webkit-scrollbar-track {
  background: #09040e;
}
::-webkit-scrollbar-thumb {
  background: linear-gradient(to bottom, #ff3366, #fda085);
  border-radius: 4px;
}

/* Canvas Overlays */
#vfx-canvas,
#trail-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
}
#vfx-canvas {
  z-index: 10;
}
#trail-canvas {
  z-index: 999;
}

/* Ambient Dream Glow Background Orbs */
.ambient-glow-wrapper {
  position: fixed;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}
.glow-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.32;
  animation: floatOrb 18s ease-in-out infinite alternate;
}
.glow-orb-1 {
  width: 420px;
  height: 420px;
  background: radial-gradient(circle, #ff2a6d, transparent 70%);
  top: 5%;
  left: -10%;
}
.glow-orb-2 {
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, #9d4edd, transparent 70%);
  bottom: 15%;
  right: -10%;
  animation-duration: 22s;
}
.glow-orb-3 {
  width: 350px;
  height: 350px;
  background: radial-gradient(circle, #fda085, transparent 70%);
  top: 50%;
  left: 20%;
  animation-duration: 16s;
}
@keyframes floatOrb {
  0% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(40px, -30px) scale(1.1); }
  100% { transform: translate(-30px, 40px) scale(0.95); }
}

/* =========================================================
   ENTRANCE CURTAIN (INTERACTION GATEWAY)
   ========================================================= */
.entrance-gate {
  position: fixed;
  inset: 0;
  z-index: 10000;
  background: radial-gradient(circle at center, #1c0628 0%, #08020d 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 1.5rem;
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.8s ease;
}
.entrance-gate.unveiled {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.entrance-content {
  max-width: 480px;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.2rem;
}

.pulsing-heart-icon {
  width: 76px;
  height: 76px;
  color: var(--rose-primary);
  filter: drop-shadow(0 0 25px rgba(255, 51, 102, 0.8));
  animation: heartPulse 1.6s ease-in-out infinite;
  cursor: pointer;
  transition: transform 0.3s ease;
  touch-action: manipulation;
}
.pulsing-heart-icon:active {
  transform: scale(1.2);
}

.entrance-title {
  font-family: var(--font-handwriting);
  font-size: clamp(2.5rem, 8vw, 4.2rem);
  background: linear-gradient(135deg, #fff2e2 20%, #fda085 60%, #ff3366 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1.2;
}

.entrance-subtitle {
  font-size: clamp(0.9rem, 3.5vw, 1.05rem);
  color: var(--text-muted);
  letter-spacing: 0.05em;
  font-weight: 300;
}

.enter-btn {
  margin-top: 0.5rem;
  padding: 0.9rem 2.2rem;
  font-size: 1.05rem;
  font-family: var(--font-body);
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #ff3366, #fda085);
  border: none;
  border-radius: 50px;
  cursor: pointer;
  box-shadow: 0 10px 25px rgba(255, 51, 102, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.4);
  transition: var(--transition-bounce);
  touch-action: manipulation;
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.enter-btn:active {
  transform: scale(0.96);
}

.entrance-hint {
  font-size: 0.8rem;
  color: var(--text-dim);
}

@keyframes heartPulse {
  0% { transform: scale(1); filter: drop-shadow(0 0 15px rgba(255, 51, 102, 0.5)); }
  15% { transform: scale(1.18); filter: drop-shadow(0 0 30px rgba(255, 51, 102, 0.85)); }
  30% { transform: scale(1.04); }
  45% { transform: scale(1.22); filter: drop-shadow(0 0 35px rgba(255, 51, 102, 0.95)); }
  60% { transform: scale(1); }
  100% { transform: scale(1); }
}

/* =========================================================
   FLOATING MUSIC PLAYER WIDGET
   ========================================================= */
.music-player-widget {
  position: fixed;
  bottom: max(18px, env(safe-area-inset-bottom));
  right: 18px;
  z-index: 1000;
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(18, 6, 26, 0.88);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border: 1px solid var(--glass-border);
  padding: 7px 14px;
  border-radius: 40px;
  box-shadow: var(--glass-shadow);
  transition: var(--transition-smooth);
}
.music-player-widget:hover {
  border-color: var(--glass-border-hover);
}

.vinyl-disc {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: radial-gradient(circle at center, #ff3366 20%, #1a0822 25%, #2a0b36 60%, #ff3366 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 8px rgba(255, 51, 102, 0.5);
  animation: spinVinyl 5s linear infinite;
  animation-play-state: paused;
  flex-shrink: 0;
}
.vinyl-disc.playing {
  animation-play-state: running;
}
@keyframes spinVinyl {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.vinyl-center-dot {
  width: 7px;
  height: 7px;
  background: #fff;
  border-radius: 50%;
}

.player-info {
  display: flex;
  flex-direction: column;
}
.player-title {
  font-size: 0.78rem;
  font-weight: 600;
  color: #fff;
}
.player-artist {
  font-size: 0.68rem;
  color: var(--text-dim);
}

.sound-visualizer {
  display: flex;
  align-items: flex-end;
  gap: 3px;
  height: 16px;
  padding: 0 2px;
}
.vis-bar {
  width: 3px;
  background: linear-gradient(to top, var(--rose-primary), var(--gold-primary));
  border-radius: 2px;
  height: 3px;
  transition: height 0.15s ease;
}
.playing .vis-bar:nth-child(1) { animation: soundBar 0.9s ease-in-out infinite alternate; }
.playing .vis-bar:nth-child(2) { animation: soundBar 0.6s ease-in-out infinite alternate 0.1s; }
.playing .vis-bar:nth-child(3) { animation: soundBar 1.1s ease-in-out infinite alternate 0.2s; }
.playing .vis-bar:nth-child(4) { animation: soundBar 0.75s ease-in-out infinite alternate 0.15s; }
@keyframes soundBar {
  0% { height: 3px; }
  100% { height: 16px; }
}

.player-btn {
  background: none;
  border: none;
  color: #fff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  transition: transform 0.2s ease, color 0.2s ease;
  touch-action: manipulation;
}
.player-btn:active {
  transform: scale(0.9);
  color: var(--rose-primary);
}
.player-btn svg {
  width: 18px;
  height: 18px;
}

/* =========================================================
   HEADER & NAVIGATION
   ========================================================= */
.main-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 900;
  padding: max(1rem, env(safe-area-inset-top)) 1.5rem 1rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: background 0.4s ease, padding 0.4s ease;
}
.main-header.scrolled {
  background: rgba(13, 4, 18, 0.9);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--glass-border);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
}

.brand-logo {
  font-family: var(--font-handwriting);
  font-size: clamp(1.8rem, 5vw, 2.3rem);
  color: #fff;
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, #ffffff, #fda085, #ff3366);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.brand-logo svg {
  width: 22px;
  height: 22px;
  fill: var(--rose-primary);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 1.8rem;
  list-style: none;
}
.nav-link {
  color: var(--text-muted);
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 500;
  transition: color 0.3s ease;
  position: relative;
}
.nav-link:hover, .nav-link:active {
  color: #fff;
}
.nav-cta {
  background: linear-gradient(135deg, rgba(255, 51, 102, 0.3), rgba(253, 160, 133, 0.3));
  border: 1px solid var(--glass-border-hover);
  padding: 0.45rem 1.1rem;
  border-radius: 25px;
  color: #fff !important;
}

/* Mobile Quick-Jump Bottom Dock */
.mobile-bottom-dock {
  display: none;
  position: fixed;
  bottom: max(14px, env(safe-area-inset-bottom));
  left: 16px;
  z-index: 998;
  background: rgba(16, 6, 24, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: 35px;
  padding: 6px 12px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
  gap: 8px;
}
.mobile-dock-btn {
  color: var(--text-muted);
  text-decoration: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  font-size: 1.1rem;
  transition: background 0.2s, transform 0.2s;
}
.mobile-dock-btn:active {
  background: rgba(255, 51, 102, 0.3);
  transform: scale(1.15);
  color: #fff;
}

/* =========================================================
   HERO SECTION
   ========================================================= */
.hero-section {
  min-height: 100vh;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 7rem 1.5rem 4rem 1.5rem;
  z-index: 1;
}

.hero-container {
  max-width: 1250px;
  width: 100%;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 3.5rem;
  align-items: center;
}

.hero-text-content {
  display: flex;
  flex-direction: column;
  gap: 1.3rem;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 16px;
  background: rgba(255, 51, 102, 0.12);
  border: 1px solid rgba(255, 51, 102, 0.3);
  border-radius: 30px;
  color: var(--gold-warm);
  font-size: clamp(0.75rem, 2.8vw, 0.85rem);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  width: fit-content;
  backdrop-filter: blur(8px);
}
.hero-tag svg {
  width: 14px;
  height: 14px;
  fill: var(--rose-primary);
  flex-shrink: 0;
}

.hero-title {
  font-family: var(--font-display);
  font-size: clamp(2.2rem, 5.5vw, 4.2rem);
  font-weight: 700;
  line-height: 1.15;
  color: #ffffff;
}
.hero-title .cursive-highlight {
  font-family: var(--font-handwriting);
  display: block;
  font-size: clamp(2.8rem, 7vw, 5.2rem);
  background: linear-gradient(135deg, #fff3e6 0%, #fda085 50%, #ff3366 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  padding-bottom: 0.2rem;
}

.hero-description {
  font-size: clamp(0.95rem, 3.2vw, 1.12rem);
  color: var(--text-muted);
  font-weight: 300;
  max-width: 500px;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-top: 0.5rem;
  flex-wrap: wrap;
}

.btn-primary {
  padding: 0.85rem 2rem;
  font-size: 1rem;
  font-family: var(--font-body);
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #ff3366, #fda085);
  border: none;
  border-radius: 50px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  box-shadow: 0 10px 25px rgba(255, 51, 102, 0.45);
  transition: var(--transition-bounce);
  text-decoration: none;
  touch-action: manipulation;
  min-height: 48px;
}
.btn-primary:active {
  transform: scale(0.96);
}

.btn-secondary {
  padding: 0.85rem 1.8rem;
  font-size: 1rem;
  font-family: var(--font-body);
  font-weight: 500;
  color: #fff;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--glass-border);
  border-radius: 50px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  transition: var(--transition-smooth);
  text-decoration: none;
  backdrop-filter: blur(10px);
  touch-action: manipulation;
  min-height: 48px;
}
.btn-secondary:active {
  background: rgba(255, 51, 102, 0.2);
  transform: scale(0.96);
}

/* Hero Visual Showcase */
.hero-visual-wrapper {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  perspective: 1200px;
  width: 100%;
}

.hero-main-card {
  position: relative;
  width: min(320px, 80vw);
  height: min(480px, 120vw);
  border-radius: 28px;
  overflow: hidden;
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.65), 0 0 35px rgba(255, 51, 102, 0.3);
  border: 2px solid var(--glass-border);
  transform-style: preserve-3d;
  transition: var(--transition-smooth);
  animation: heroFloat 6s ease-in-out infinite alternate;
}
@keyframes heroFloat {
  0% { transform: translateY(0px) rotate(1deg); }
  100% { transform: translateY(-14px) rotate(-1deg); }
}

.hero-main-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.hero-card-glow {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 45%, rgba(10, 2, 16, 0.88) 100%);
  pointer-events: none;
}
.hero-card-caption {
  position: absolute;
  bottom: 20px;
  left: 20px;
  right: 20px;
  z-index: 2;
}
.hero-card-caption h4 {
  font-family: var(--font-handwriting);
  font-size: clamp(1.8rem, 5vw, 2.2rem);
  color: #fff;
}
.hero-card-caption p {
  font-size: 0.8rem;
  color: var(--text-muted);
}

/* Floating Satellite Badges */
.floating-mini-badge {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 14px;
  background: rgba(22, 8, 32, 0.85);
  backdrop-filter: blur(14px);
  border: 1px solid var(--glass-border);
  border-radius: 50px;
  box-shadow: var(--glass-shadow);
  z-index: 5;
  animation: miniBadgeFloat 5s ease-in-out infinite alternate;
}
.badge-top-left {
  top: 6%;
  left: 0;
  animation-delay: 0.4s;
}
.badge-bottom-right {
  bottom: 8%;
  right: 0;
  animation-delay: 1.2s;
}
@keyframes miniBadgeFloat {
  0% { transform: translateY(0); }
  100% { transform: translateY(-10px); }
}

.mini-badge-thumb {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--rose-primary);
  flex-shrink: 0;
}
.mini-badge-text span {
  display: block;
  font-size: 0.8rem;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
}
.mini-badge-text small {
  font-size: 0.7rem;
  color: var(--gold-warm);
  display: block;
}

/* =========================================================
   GALLERY SECTION (ALL 5 PHOTOS)
   ========================================================= */
.section-wrapper {
  padding: 5rem 1.5rem;
  position: relative;
  z-index: 2;
  width: 100%;
}

.section-header {
  text-align: center;
  max-width: 650px;
  margin: 0 auto 3rem auto;
}
.section-subtitle {
  font-family: var(--font-handwriting);
  font-size: clamp(2rem, 6vw, 2.5rem);
  color: var(--rose-primary);
  margin-bottom: -0.4rem;
  display: block;
}
.section-title {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 5vw, 3rem);
  color: #fff;
  margin-bottom: 0.8rem;
}
.section-desc {
  font-size: clamp(0.9rem, 3.2vw, 1.05rem);
  color: var(--text-muted);
  font-weight: 300;
}

.gallery-grid {
  max-width: 1300px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  gap: 2rem;
  width: 100%;
}

.gallery-card-3d {
  position: relative;
  height: min(520px, 130vw);
  border-radius: 24px;
  perspective: 1000px;
  cursor: pointer;
  touch-action: pan-y;
  width: 100%;
}

.gallery-card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 24px;
  overflow: hidden;
  background: var(--bg-card);
  border: 1px solid var(--glass-border);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.45);
  transform-style: preserve-3d;
  transition: transform 0.2s cubic-bezier(0.2, 0, 0.3, 1), box-shadow 0.3s ease;
}

.gallery-card-3d:active .gallery-card-inner {
  border-color: var(--glass-border-hover);
  transform: scale(0.98);
}

.gallery-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(9, 3, 14, 0.95) 0%, rgba(9, 3, 14, 0.45) 45%, transparent 75%);
  pointer-events: none;
}

.card-shine {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.25) 0%, transparent 60%);
  opacity: 0;
  pointer-events: none;
  mix-blend-mode: overlay;
  transition: opacity 0.3s ease;
}

.card-details {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1.5rem;
  z-index: 3;
  transform: translateZ(25px);
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.card-badge {
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold-primary);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 5px;
}

.card-title {
  font-family: var(--font-display);
  font-size: clamp(1.4rem, 4vw, 1.7rem);
  color: #fff;
  font-weight: 600;
  line-height: 1.2;
}

.card-quote {
  font-family: var(--font-handwriting);
  font-size: clamp(1.3rem, 3.8vw, 1.6rem);
  color: #ffb8cf;
  line-height: 1.3;
}

.card-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 0.6rem;
  padding-top: 0.6rem;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
}

.reaction-btn {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 30px;
  padding: 6px 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: #fff;
  font-size: 0.85rem;
  cursor: pointer;
  touch-action: manipulation;
  min-height: 38px;
}
.reaction-btn svg {
  width: 16px;
  height: 16px;
  fill: var(--rose-primary);
}
.reaction-btn:active {
  background: rgba(255, 51, 102, 0.35);
  transform: scale(1.1);
}

.view-fullscreen-hint {
  font-size: 0.75rem;
  color: var(--text-dim);
}

/* =========================================================
   WAX SEAL LOVE LETTER (PHONE-OPTIMIZED)
   ========================================================= */
.love-letter-section {
  padding: 5rem 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
  width: 100%;
}

.envelope-wrapper {
  position: relative;
  width: min(560px, 92vw);
  height: min(360px, 60vw);
  min-height: 220px;
  margin: 2rem auto 0 auto;
  perspective: 1200px;
  cursor: pointer;
  touch-action: manipulation;
}

.envelope {
  position: relative;
  width: 100%;
  height: 100%;
  background: #2a0e28;
  border-radius: 16px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), 0 0 30px rgba(255, 51, 102, 0.2);
  border: 1px solid var(--glass-border);
  overflow: visible;
  transition: transform 0.5s ease;
}

.envelope-flap {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 50%;
  background: linear-gradient(180deg, #3d153a, #2a0e28);
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  transform-origin: top;
  transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 10;
  border-top-left-radius: 16px;
  border-top-right-radius: 16px;
}

.wax-seal {
  position: absolute;
  top: 42%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: clamp(52px, 12vw, 68px);
  height: clamp(52px, 12vw, 68px);
  background: radial-gradient(circle, #ff2a6d 0%, #b30036 80%, #730022 100%);
  border-radius: 50%;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.6), inset 0 2px 3px rgba(255, 255, 255, 0.4), 0 0 16px rgba(255, 42, 109, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 12;
  cursor: pointer;
  touch-action: manipulation;
}
.wax-seal svg {
  width: 50%;
  height: 50%;
  fill: #fff;
}
.wax-seal:active {
  transform: translate(-50%, -50%) scale(1.15);
}

.envelope-pocket {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 75%;
  background: linear-gradient(0deg, #1f071e, #290b27);
  clip-path: polygon(0 100%, 100% 100%, 100% 20%, 50% 70%, 0 20%);
  z-index: 8;
  border-bottom-left-radius: 16px;
  border-bottom-right-radius: 16px;
}

/* Letter Paper */
.letter-paper {
  position: absolute;
  top: 10px;
  left: 12px;
  right: 12px;
  height: calc(100% - 20px);
  background: #fff9f0;
  border-radius: 10px;
  padding: 1.5rem;
  color: #2b1122;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  z-index: 5;
  transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.letter-heading {
  font-family: var(--font-handwriting);
  font-size: clamp(1.8rem, 5vw, 2.4rem);
  color: var(--crimson);
  line-height: 1.1;
}

.letter-body {
  font-family: 'Playfair Display', serif;
  font-size: clamp(0.85rem, 2.8vw, 1.05rem);
  line-height: 1.65;
  color: #381a2f;
  font-style: italic;
}

.letter-sign {
  font-family: var(--font-handwriting);
  font-size: clamp(1.5rem, 4.5vw, 2rem);
  color: var(--crimson);
  text-align: right;
  margin-top: auto;
}

/* Envelope Open State */
.envelope-wrapper.opened .envelope-flap {
  transform: rotateX(180deg);
  z-index: 1;
}
.envelope-wrapper.opened .wax-seal {
  opacity: 0;
  pointer-events: none;
}
.envelope-wrapper.opened .letter-paper {
  transform: translateY(-42%);
  height: clamp(340px, 85vw, 460px);
  z-index: 20;
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.7);
  overflow-y: auto;
}

.envelope-prompt {
  text-align: center;
  margin-top: 1.5rem;
  color: var(--gold-warm);
  font-size: 0.9rem;
  display: flex;
  align-items: center;
  gap: 6px;
}
.envelope-prompt svg {
  width: 16px;
  height: 16px;
  fill: var(--gold-warm);
}

/* =========================================================
   REASON CARDS SECTION
   ========================================================= */
.reasons-section {
  padding: 5rem 1.5rem;
  position: relative;
  z-index: 2;
  width: 100%;
}

.reasons-grid {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  gap: 1.5rem;
}

.reason-card {
  background: var(--bg-card);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid var(--glass-border);
  border-radius: 20px;
  padding: 1.8rem;
  box-shadow: var(--glass-shadow);
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  position: relative;
  overflow: hidden;
  transition: var(--transition-smooth);
  cursor: pointer;
  touch-action: manipulation;
}
.reason-card:active {
  transform: scale(0.98);
  border-color: var(--glass-border-hover);
}

.reason-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: rgba(255, 51, 102, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  border: 1px solid rgba(255, 51, 102, 0.3);
}

.reason-title {
  font-family: var(--font-display);
  font-size: 1.25rem;
  color: #fff;
}

.reason-desc {
  font-size: 0.92rem;
  color: var(--text-muted);
  line-height: 1.6;
}

/* =========================================================
   TOUCH INTERACTIVE LOVE SHOWER ZONE
   ========================================================= */
.touch-zone-section {
  padding: 5rem 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 2;
  width: 100%;
}

.touch-zone-card {
  max-width: 720px;
  width: 100%;
  background: linear-gradient(135deg, rgba(32, 11, 44, 0.85), rgba(18, 5, 26, 0.85));
  border: 1px solid var(--glass-border-hover);
  border-radius: 28px;
  padding: 3rem 1.5rem;
  text-align: center;
  backdrop-filter: blur(20px);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
}

.counter-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 20px;
  background: rgba(255, 51, 102, 0.15);
  border: 1px solid rgba(255, 51, 102, 0.35);
  border-radius: 40px;
  font-size: 1rem;
  color: var(--gold-warm);
}
.counter-badge span {
  font-weight: 700;
  font-size: 1.3rem;
  color: #fff;
}

.heart-blast-trigger {
  width: clamp(80px, 22vw, 105px);
  height: clamp(80px, 22vw, 105px);
  border-radius: 50%;
  background: linear-gradient(135deg, #ff2a6d, #fda085);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12px 35px rgba(255, 51, 102, 0.6), inset 0 2px 4px rgba(255,255,255,0.4);
  transition: var(--transition-bounce);
  touch-action: manipulation;
}
.heart-blast-trigger svg {
  width: 50%;
  height: 50%;
  fill: #fff;
}
.heart-blast-trigger:active {
  transform: scale(0.88);
}

.touch-hint {
  font-size: 0.85rem;
  color: var(--text-dim);
}

/* =========================================================
   LIGHTBOX MODAL (PHONE & DESKTOP)
   ========================================================= */
.lightbox-modal {
  position: fixed;
  inset: 0;
  z-index: 10005;
  background: rgba(8, 2, 12, 0.94);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.35s ease, visibility 0.35s ease;
  padding: 1rem;
}
.lightbox-modal.active {
  opacity: 1;
  visibility: visible;
}

.lightbox-content {
  position: relative;
  max-width: 850px;
  width: 100%;
  max-height: 90vh;
  display: flex;
  flex-direction: row;
  background: #15071d;
  border: 1px solid var(--glass-border-hover);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85);
}

.lightbox-img-wrapper {
  flex: 1.2;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.lightbox-img-wrapper img {
  width: 100%;
  height: 100%;
  max-height: 70vh;
  object-fit: contain;
}

.lightbox-details {
  flex: 1;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1rem;
  background: radial-gradient(circle at top right, #250b32, #14051b);
  overflow-y: auto;
}

.lightbox-title {
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 4vw, 2rem);
  color: #fff;
  line-height: 1.2;
}

.lightbox-poem {
  font-family: var(--font-handwriting);
  font-size: clamp(1.4rem, 3.5vw, 1.8rem);
  color: #ff94b8;
  line-height: 1.35;
}

.lightbox-note {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.6;
}

.close-modal-btn {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 1.4rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition-bounce);
  z-index: 10;
  touch-action: manipulation;
}
.close-modal-btn:active {
  background: var(--rose-primary);
  transform: scale(0.9);
}

/* =========================================================
   FOOTER
   ========================================================= */
.main-footer {
  padding: 3rem 1.5rem 5rem 1.5rem;
  text-align: center;
  position: relative;
  z-index: 2;
  border-top: 1px solid var(--glass-border);
  background: rgba(7, 2, 10, 0.6);
}
.footer-text {
  font-family: var(--font-handwriting);
  font-size: clamp(1.8rem, 5vw, 2.3rem);
  background: linear-gradient(135deg, #fff, #fda085, #ff3366);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 0.4rem;
}
.footer-sub {
  font-size: 0.8rem;
  color: var(--text-dim);
}

/* =========================================================
   MOBILE RESPONSIVE BREAKPOINTS (SMARTPHONES & TABLETS)
   ========================================================= */
@media (max-width: 900px) {
  .hero-container {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 2.5rem;
  }
  .hero-text-content {
    align-items: center;
  }
  .hero-actions {
    justify-content: center;
  }
  .lightbox-content {
    flex-direction: column;
    max-height: 88vh;
  }
  .lightbox-img-wrapper img {
    max-height: 42vh;
  }
  .lightbox-details {
    padding: 1.5rem;
  }
}

@media (max-width: 600px) {
  .main-header {
    padding: max(0.8rem, env(safe-area-inset-top)) 1rem 0.8rem 1rem;
  }
  .nav-links {
    display: none;
  }
  .mobile-bottom-dock {
    display: flex;
  }
  
  /* Music player adjusts to bottom right above dock */
  .music-player-widget {
    bottom: max(14px, env(safe-area-inset-bottom));
    right: 14px;
    padding: 6px 10px;
    gap: 8px;
  }
  .player-artist {
    display: none;
  }
  #volume-slider {
    display: none;
  }

  /* Hero on Phone */
  .hero-section {
    padding-top: 5.5rem;
    padding-bottom: 3rem;
  }
  .badge-top-left {
    left: -5px;
  }
  .badge-bottom-right {
    right: -5px;
  }

  /* Wax Letter on Phone */
  .envelope-wrapper {
    height: 220px;
    margin-top: 1rem;
  }
  .envelope-wrapper.opened .letter-paper {
    transform: translateY(-80px);
    height: 330px;
    padding: 1.2rem;
  }

  .gallery-card-3d {
    height: 440px;
  }
}
